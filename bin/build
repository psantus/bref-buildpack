#!/usr/bin/env bash
set -eo pipefail

# =============================================================================
# Bref PHP Lambda Buildpack - Build Phase
#
# This script:
#   1. Installs Bref extra PHP extensions (cached layer)
#   2. Configures OPcache/JIT for Lambda cold start optimization
#   3. Runs composer install with production optimizations (cached layer)
#   4. Optionally runs vendor shrink scripts
#   5. Detects and warms Symfony cache (if applicable)
#   6. Places application at /var/task for Lambda compatibility
#   7. Sets the launch command using Bref's entrypoint
# =============================================================================

echo "===> Bref PHP Lambda Buildpack"

# --- Configuration from env vars ---
PHP_VERSION="${BP_PHP_VERSION:-84}"
BREF_EXTENSIONS="${BP_BREF_EXTENSIONS:-}"
BREF_RUNTIME="${BP_BREF_RUNTIME:-function}"
COMPOSER_FLAGS="${BP_COMPOSER_FLAGS:---no-dev --classmap-authoritative --no-scripts}"
OPCACHE_ENABLE="${BP_OPCACHE_ENABLE:-true}"
OPCACHE_JIT="${BP_OPCACHE_JIT:-false}"
SYMFONY_WARMUP="${BP_SYMFONY_WARMUP:-auto}"
HANDLER="${BP_HANDLER:-public/index.php}"
VENDOR_SHRINK="${BP_VENDOR_SHRINK:-true}"
BREF_MAJOR="3"

# Detect platform architecture (for multi-arch image references)
if [[ -n "${BP_BREF_ARCH:-}" ]]; then
    BREF_ARCH="${BP_BREF_ARCH}"
else
    case "$(uname -m)" in
        aarch64) BREF_ARCH="arm64" ;;
        x86_64)  BREF_ARCH="amd64" ;;
        *)       BREF_ARCH="arm64" ;;  # default to arm64 (Graviton)
    esac
fi

# --- Helper functions ---
log_step() { echo "-----> $1"; }
log_info() { echo "       $1"; }

# =============================================================================
# STEP 1: PHP Extensions Layer
# =============================================================================
extensions_layer="${CNB_LAYERS_DIR}/extensions"
mkdir -p "${extensions_layer}"

if [[ -n "${BREF_EXTENSIONS}" ]]; then
    log_step "Installing Bref extra PHP extensions: ${BREF_EXTENSIONS}"

    # Check if cached extensions match current config
    cached_extensions=$(cat "${CNB_LAYERS_DIR}/extensions.toml" 2>/dev/null | grep 'extensions =' | cut -d'"' -f2 || echo "")

    if [[ "${cached_extensions}" == "${BREF_EXTENSIONS}" ]]; then
        log_info "Reusing cached extensions layer"
    else
        # Install extensions from bref-extra Docker images
        IFS=',' read -ra EXTS <<< "${BREF_EXTENSIONS}"
        for ext in "${EXTS[@]}"; do
            ext=$(echo "${ext}" | xargs)  # trim whitespace
            ext_image="bref/extra-${ext}-php-${PHP_VERSION}:${BREF_MAJOR}"
            log_info "Installing extension: ${ext} (from ${ext_image})"

            installed=false

            # Method 1: Use crane (preferred for CI — no Docker daemon needed)
            if command -v crane &>/dev/null; then
                log_info "  Using crane to extract extension"
                # Export to a temp file first, then extract (avoids pipe exit code issues)
                tmp_tar="/tmp/ext-${ext}.tar"
                if crane export "${ext_image}" --platform "linux/${BREF_ARCH}" "${tmp_tar}" 2>/dev/null; then
                    tar -xf "${tmp_tar}" -C "${extensions_layer}/" opt/ 2>/dev/null && installed=true
                    rm -f "${tmp_tar}"
                    if [[ "${installed}" == "true" ]]; then
                        log_info "  ✓ Installed via crane"
                    fi
                else
                    log_info "  crane export failed (network unavailable or image not found)"
                    rm -f "${tmp_tar}" 2>/dev/null
                fi
            fi

            # Method 2: Fall back to docker create + docker cp (requires Docker daemon)
            if [[ "${installed}" == "false" ]] && command -v docker &>/dev/null; then
                log_info "  Falling back to docker create + docker cp"
                container_id=$(docker create --platform "linux/${BREF_ARCH}" "${ext_image}" /bin/true 2>/dev/null || true)
                if [[ -n "${container_id}" ]]; then
                    docker cp "${container_id}:/opt/." "${extensions_layer}/" 2>/dev/null || true
                    docker rm "${container_id}" >/dev/null 2>&1 || true
                    installed=true
                fi
            fi

            # Method 3: Compile from source (ARM builds, or when crane/docker fail)
            if [[ "${installed}" == "false" ]]; then
                RECIPES_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/extension-recipes.sh"
                if [[ -f "${RECIPES_FILE}" ]]; then
                    # Source the recipes
                    source "${RECIPES_FILE}"

                    recipe_fn="recipe_${ext}"
                    if declare -f "${recipe_fn}" > /dev/null 2>&1; then
                        log_info "  Compiling from source (ARM)"
                        mkdir -p "${EXT_OUTPUT}"

                        if ${recipe_fn} 2>&1 | while read -r line; do echo "       ${line}"; done; then
                            # Copy compiled extension to the layer
                            if [[ -f "${EXT_OUTPUT}/${ext}.so" ]]; then
                                mkdir -p "${extensions_layer}/opt/bref/extensions"
                                mkdir -p "${extensions_layer}/opt/bref/etc/php/conf.d"
                                mkdir -p "${extensions_layer}/opt/lib"

                                cp "${EXT_OUTPUT}/${ext}.so" "${extensions_layer}/opt/bref/extensions/"
                                cp "${EXT_OUTPUT}/${ext}.ini" "${extensions_layer}/opt/bref/etc/php/conf.d/ext-${ext}.ini" 2>/dev/null || true

                                # Copy shared library dependencies
                                if [[ -d "${EXT_OUTPUT}/${ext}-libs" ]]; then
                                    cp -a "${EXT_OUTPUT}/${ext}-libs/"* "${extensions_layer}/opt/lib/" 2>/dev/null || true
                                fi

                                installed=true
                                log_info "  ✓ Compiled and installed ${ext}.so"
                            else
                                log_info "  ERROR: Compilation succeeded but ${ext}.so not found"
                            fi
                        else
                            log_info "  ERROR: Compilation failed for ${ext}"
                        fi

                        # Cleanup
                        rm -rf "${EXT_OUTPUT}" 2>/dev/null || true
                    else
                        log_info "  WARNING: No build recipe for '${ext}'"
                        log_info "  Add recipe_${ext}() to lib/extension-recipes.sh"
                    fi
                else
                    log_info "  WARNING: Cannot install '${ext}' — no crane/docker and recipes file not found"
                fi
            fi
        done
    fi

    # Mark layer as cached and available at launch
    cat > "${CNB_LAYERS_DIR}/extensions.toml" << EOL
[types]
cache = true
launch = true
build = true

[metadata]
extensions = "${BREF_EXTENSIONS}"
php_version = "${PHP_VERSION}"
EOL
else
    log_step "No extra extensions requested (BP_BREF_EXTENSIONS is empty)"
    cat > "${CNB_LAYERS_DIR}/extensions.toml" << EOL
[types]
cache = false
launch = false
build = false
EOL
fi

# =============================================================================
# STEP 2: OPcache Configuration Layer
# =============================================================================
if [[ "${OPCACHE_ENABLE}" == "true" ]]; then
    log_step "Configuring OPcache for Lambda"

    opcache_layer="${CNB_LAYERS_DIR}/opcache"
    mkdir -p "${opcache_layer}"

    # Write OPcache config to the layer directory.
    # At runtime, this will be available via the layer path.
    # We also try to write to /opt/bref/etc/php/conf.d/ if writable (build-time use).
    local_ini="${opcache_layer}/opcache-buildpack.ini"

    cat > "${local_ini}" << EOL
; Buildpack OPcache configuration for Lambda cold start optimization
opcache.enable=1
opcache.enable_cli=1
opcache.memory_consumption=1024
opcache.max_accelerated_files=20000
opcache.validate_timestamps=0
opcache.preload_user=nobody
EOL

    if [[ "${OPCACHE_JIT}" == "true" ]]; then
        log_info "JIT enabled (opcache.jit=1255, buffer=128M)"
        cat >> "${local_ini}" << EOL
opcache.jit=1255
opcache.jit_buffer_size=128M
EOL
    fi

    # Also store a copy in the layer for reference/caching
    mkdir -p "${opcache_layer}/opt/bref/etc/php/conf.d"
    cp "${local_ini}" "${opcache_layer}/opt/bref/etc/php/conf.d/opcache-buildpack.ini"

    log_info "Wrote OPcache config to ${local_ini}"
    log_info "Settings: memory=1024M, max_files=20000, validate_timestamps=0"

    cat > "${CNB_LAYERS_DIR}/opcache.toml" << EOL
[types]
cache = true
launch = true

[metadata]
jit = "${OPCACHE_JIT}"
EOL
fi

# =============================================================================
# STEP 3: Composer Install Layer (cached)
# =============================================================================
log_step "Running composer install"

vendor_layer="${CNB_LAYERS_DIR}/vendor"
mkdir -p "${vendor_layer}"

# Calculate composer.lock checksum for cache invalidation
composer_lock_sha=""
if [[ -f "composer.lock" ]]; then
    composer_lock_sha=$(sha256sum composer.lock | cut -d' ' -f1)
elif [[ -f "composer.json" ]]; then
    composer_lock_sha=$(sha256sum composer.json | cut -d' ' -f1)
fi

cached_lock_sha=$(cat "${CNB_LAYERS_DIR}/vendor.toml" 2>/dev/null | grep 'lock_sha =' | cut -d'"' -f2 || echo "")

if [[ "${composer_lock_sha}" == "${cached_lock_sha}" && -d "${vendor_layer}/vendor" ]]; then
    log_info "Reusing cached vendor layer (composer.lock unchanged)"
    # Symlink vendor from cache
    ln -sf "${vendor_layer}/vendor" vendor
else
    log_info "Installing dependencies: composer install ${COMPOSER_FLAGS}"

    if command -v composer &>/dev/null; then
        # Use 'install' if lock file exists, otherwise 'update' to generate one
        if [[ -f "composer.lock" ]]; then
            # shellcheck disable=SC2086
            composer install ${COMPOSER_FLAGS} --no-interaction --prefer-dist 2>&1 | while read -r line; do
                echo "       ${line}"
            done
        else
            log_info "No composer.lock found — running composer update"
            # shellcheck disable=SC2086
            composer update ${COMPOSER_FLAGS} --no-interaction --prefer-dist 2>&1 | while read -r line; do
                echo "       ${line}"
            done
        fi
    else
        log_info "ERROR: composer not found in build image."
        exit 1
    fi

    # Copy vendor to the layer for caching
    if [[ -d "vendor" ]]; then
        rm -rf "${vendor_layer}/vendor"
        cp -a vendor "${vendor_layer}/vendor"
    fi
fi

# --- Vendor shrink ---
if [[ "${VENDOR_SHRINK}" == "true" ]]; then
    if command -v composer &>/dev/null; then
        has_shrink=$(jq -r '.scripts["shrink-vendor"] // empty' composer.json 2>/dev/null || echo "")
        if [[ -n "${has_shrink}" ]]; then
            log_info "Running vendor shrink script"
            composer run-script shrink-vendor 2>&1 | while read -r line; do
                echo "       ${line}"
            done
            # Update cached vendor after shrink
            rm -rf "${vendor_layer}/vendor"
            cp -a vendor "${vendor_layer}/vendor"
        fi
    fi
fi

cat > "${CNB_LAYERS_DIR}/vendor.toml" << EOL
[types]
cache = true
launch = true

[metadata]
lock_sha = "${composer_lock_sha}"
EOL

# =============================================================================
# STEP 4: Symfony Detection & Cache Warmup
# =============================================================================
is_symfony=false
if [[ -f "bin/console" ]] || [[ -f "symfony.lock" ]]; then
    is_symfony=true
fi

if [[ "${is_symfony}" == "true" && ("${SYMFONY_WARMUP}" == "true" || "${SYMFONY_WARMUP}" == "auto") ]]; then
    log_step "Detected Symfony application — warming cache"

    symfony_layer="${CNB_LAYERS_DIR}/symfony-cache"
    mkdir -p "${symfony_layer}"

    # Create var directories
    mkdir -p var/cache var/log

    # Dump env if .env file exists
    if [[ -f ".env" ]] && command -v composer &>/dev/null; then
        log_info "Dumping .env for production"
        composer dump-env prod 2>/dev/null || true
    fi

    # Warm up the Symfony DI container
    if command -v php &>/dev/null; then
        log_info "Running cache:warmup --env=prod"
        php -d memory_limit=512M bin/console cache:warmup --env=prod 2>&1 | while read -r line; do
            echo "       ${line}"
        done || log_info "WARNING: cache:warmup failed (may need DATABASE_URL or other env vars)"

        # Install assets
        if [[ -d "public" ]]; then
            log_info "Installing assets"
            mkdir -p public/bundles
            php -d memory_limit=512M bin/console assets:install public --no-interaction --env=prod 2>/dev/null || true
        fi
    fi

    cat > "${CNB_LAYERS_DIR}/symfony-cache.toml" << EOL
[types]
cache = false
launch = true

[metadata]
framework = "symfony"
EOL
fi

# =============================================================================
# STEP 5: Application Layer
# =============================================================================
log_step "Preparing application layer"

# The application source stays at /workspace (CNB default).
# For Lambda deployment, the 'make lambda' flatten step copies it to /var/task.
# This separation keeps the buildpack CNB-compliant while supporting Lambda.

app_layer="${CNB_LAYERS_DIR}/app"
mkdir -p "${app_layer}"

cat > "${CNB_LAYERS_DIR}/app.toml" << EOL
[types]
cache = false
launch = true
EOL

# =============================================================================
# STEP 6: Environment & Launch Configuration
# =============================================================================
log_step "Configuring launch (handler: ${HANDLER}, runtime: ${BREF_RUNTIME})"

# --- Set environment variables via CNB layer ---
# BREF_RUNTIME tells the Bref bootstrap which runtime class to use
env_layer="${CNB_LAYERS_DIR}/env"
mkdir -p "${env_layer}/env.launch"
echo -n "${BREF_RUNTIME}" > "${env_layer}/env.launch/BREF_RUNTIME"

cat > "${CNB_LAYERS_DIR}/env.toml" << EOL
[types]
cache = false
launch = true
build = false
EOL

# --- Launch process ---
# The Bref entrypoint (/lambda-entrypoint.sh) is the standard Lambda container
# entrypoint. It receives the handler as CMD. For Lambda deployment, the
# flatten step overrides the entrypoint. Here we define processes for CNB.
cat > "${CNB_LAYERS_DIR}/launch.toml" << EOL
[[processes]]
type = "web"
command = ["${HANDLER}"]
default = true

[[processes]]
type = "console"
command = ["bin/console"]

[[processes]]
type = "worker"
command = ["bin/consumer.php"]
EOL

# =============================================================================
# Summary
# =============================================================================
echo ""
echo "===> Build complete!"
echo "     PHP Version:  ${PHP_VERSION}"
echo "     Runtime:      ${BREF_RUNTIME}"
echo "     Handler:      ${HANDLER}"
echo "     Extensions:   ${BREF_EXTENSIONS:-none}"
echo "     OPcache:      ${OPCACHE_ENABLE} (JIT: ${OPCACHE_JIT})"
echo "     Symfony:      ${is_symfony}"
echo ""
